# Login dashboard (wajib). Isi di Vercel > Project > Settings > Environment Variables.
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=ganti-dengan-password-kuat
# Kunci penanda sesi, minimal 32 karakter acak. Buat: openssl rand -base64 48
SESSION_SECRET=
# Opsional
# SESSION_HOURS=8
# SYNC_TTL_SECONDS=300
